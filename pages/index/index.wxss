.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #f5f7fb 0%, #eef1f7 55%, #e8ecf3 100%);
  overflow: hidden;
  box-sizing: border-box;
}

.status-bar {
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 16rpx;
  flex-shrink: 0;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #1f2430;
  line-height: 1.4;
}

.hint {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #8a91a6;
}

.stage {
  position: relative;
  flex: 1;
  min-height: 0;
  margin: 0 24rpx;
  border-radius: 24rpx;
  background: radial-gradient(ellipse at 50% 28%, #ffffff 0%, #f4f6fb 55%, #e9edf4 100%);
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(60, 70, 110, 0.08), inset 0 0 40rpx rgba(120, 130, 170, 0.06);
}

.gl {
  width: 100%;
  height: 100%;
}

.loading {
  position: absolute;
  left: 0;
  right: 0;
  top: 42%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 0 60rpx;
  text-align: center;
  transition: opacity 0.4s;
}

.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid rgba(120, 130, 170, 0.18);
  border-top-color: #7c6cff;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
}

.loading.hidden {
  opacity: 0;
  pointer-events: none;
}

.panel {
  flex-shrink: 0;
  margin: 24rpx;
  padding: 24rpx 28rpx 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e8ebf2;
  box-shadow: 0 6rpx 24rpx rgba(60, 70, 110, 0.06);
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.row:last-of-type {
  margin-bottom: 12rpx;
}

.label {
  width: 96rpx;
  font-size: 26rpx;
  color: #5a6178;
  flex-shrink: 0;
}

.seg {
  display: flex;
  background: #eef1f6;
  border-radius: 14rpx;
  padding: 4rpx;
}

.seg-item {
  padding: 10rpx 44rpx;
  font-size: 26rpx;
  color: #6b7280;
  border-radius: 12rpx;
  transition: all 0.25s;
}

.seg-item.active {
  background: linear-gradient(135deg, #7c6cff, #5b8cff);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(108, 108, 255, 0.35);
}

.seg-wide .seg-item {
  padding: 10rpx 22rpx;
  font-size: 24rpx;
}

.btn {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  border-radius: 14rpx;
  margin-right: 16rpx;
}

.btn.primary {
  background: linear-gradient(135deg, #ff8f5c, #ff5c8a);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(255, 92, 138, 0.3);
}

.btn.ghost {
  background: #f0f2f7;
  color: #5a6178;
  border: 1rpx solid #e2e6ee;
}

.btn.ghost.disabled {
  opacity: 0.4;
}

.tip {
  font-size: 22rpx;
  color: #9aa1b5;
  line-height: 1.5;
}

.ai-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.ai-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #1f2430;
  background: #f0f2f7;
  border: 1rpx solid #e2e6ee;
  border-radius: 14rpx;
}

.ai-btn {
  background: linear-gradient(135deg, #7c6cff, #5b8cff);
  color: #ffffff;
  font-weight: 600;
  padding: 12rpx 28rpx;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(108, 108, 255, 0.3);
}

.ai-btn.disabled {
  opacity: 0.5;
}
